# Build artifacts
*.o
*.a
*.so
*.pyc
__pycache__/
*.json~
*~

# wfsource build output dirs
wfsource/source/obj*/
wfsource/bin/

# wftools build output dirs
engine/objs_game/
wftools/*/target/

# CMake build output dirs
cmake-build-*/
build*/

# Packaged addon/tool artifacts (e.g. dist/wf_asset_browser-*.zip)
dist/

# Codemagic artifact downloads (CI output, never source)
WorldFoundry_*_artifacts.zip
wf_game.app.zip
wf_game.app.dSYM.zip
wf_game.app/
wf_game.app.dSYM/

# Built game binary
engine/wf_game
# Built editor/dev engine binary (engine/build_game.sh WF_ENABLE_EDITOR=1)
engine/wf_game-dev

# Preprocessor temp files (build artifacts)
*.pp.tmp

# Editor
*.swp
.DS_Store

# Claude Code runtime state
.claude/scheduled_tasks.lock

# Level-build intermediate artifacts (regenerated by build_level_binary.sh)
wflevels/*/asset.inc
wflevels/*/textile.log.htm
wflevels/*/*.lev.bin

# pytest debug-bridge harness artifacts
tests/.wf_game.log
tests/.pytest_cache/
# All dot-files in tests/ are ephemeral run artifacts (.log, .lev, .lvl, .ppm, .txt, etc.)
tests/.*

# Top-level build/run artifacts
objs_game/
log

# Phase E walker captures (regenerable via scripts/research/wf/qbert_wf_walker.py)
docs/investigations/wf-screenshots/wf_walker_*.png

# Harness binaries (built by engine/build_host_gl_test.sh)
engine/wf_host_gl_test/wf_host_gl_test

# Dear ImGui runtime layout file (written by wf-edit on exit)
imgui.ini

# wf_blender test harness cache (built wf_core.so)
tests/.cache/
wfsource/source/game/output.mp4
