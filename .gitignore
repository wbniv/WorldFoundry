# Build artifacts
*.o
*.a
*.so
*.pyc
__pycache__/
*.json~
*~

# wfsource build output dirs
wfsource/source/obj*/
wfsource/bin/

# wftools build output dirs
engine/objs_game/
wftools/*/target/

# CMake build output dirs
cmake-build-*/
build*/

# Packaged addon/tool artifacts (e.g. dist/wf_asset_browser-*.zip)
dist/

# Codemagic artifact downloads (CI output, never source)
WorldFoundry_*_artifacts.zip
wf_game.app.zip
wf_game.app.dSYM.zip
wf_game.app/
wf_game.app.dSYM/

# Built game binary
engine/wf_game
# Built editor/dev engine binary (engine/build_game.sh WF_ENABLE_EDITOR=1)
engine/wf_game-dev

# Preprocessor temp files (build artifacts)
*.pp.tmp

# Editor
*.swp
.DS_Store

# Claude Code runtime state
.claude/scheduled_tasks.lock

# Level-build intermediate artifacts (regenerated by build_level_binary.sh)
wflevels/*/asset.inc
wflevels/*/textile.log.htm
wflevels/*/*.lev.bin
# aquarium touch profile (task aquarium-touch-level): regenerable; its directory ignores itself
wflevels/aquarium_touch.iff
wflevels/aquarium_touch-standalone.iff
wflevels/aquarium_bench.iff
wflevels/aquarium_bench-standalone.iff
wflevels/aquarium_probe.iff
wflevels/aquarium_probe-standalone.iff

# pytest debug-bridge harness artifacts
tests/.wf_game.log
tests/.pytest_cache/
# All dot-files in tests/ are ephemeral run artifacts (.log, .lev, .lvl, .ppm, .txt, etc.)
tests/.*

# Top-level build/run artifacts
objs_game/
log

# Phase E walker captures (regenerable via scripts/research/wf/qbert_wf_walker.py)
docs/investigations/wf-screenshots/wf_walker_*.png

# Harness binaries (built by engine/build_host_gl_test.sh)
engine/wf_host_gl_test/wf_host_gl_test

# Dear ImGui runtime layout file (written by wf-edit on exit)
imgui.ini

# wf_blender test harness cache (built wf_core.so)
tests/.cache/

# emsdk: the manager scripts are NOT in git; `task emsdk-manager` clones them at a pinned
# commit into engine/vendor/emsdk-6.0.0/, and `task setup-emsdk` fetches the toolchain
# binaries. Ignore the whole directory (it is a nested git clone).
engine/vendor/emsdk-6.0.0/

# Web build output
build-web/
wfsource/source/game/output.mp4

# Task (go-task) checksum fingerprints
.task/
# Blender autosave backups
*.blend1

# One-time credential setup (scripts/setup.sh) run logs + session caches
.setup-logs/

# Separate local Git checkouts; their changes belong to their own branches.
/.worktrees/
