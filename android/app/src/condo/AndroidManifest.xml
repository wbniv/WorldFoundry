<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into src/main/AndroidManifest.xml for this flavor only.
     The phone as a gamepad (hal/phonepad, docs/plans/2026-09-30-aquarium-chromecast.md, Phase E):
     the app listens on its Wi-Fi address while resumed, and opening a socket needs INTERNET.
     Only the flavors that ship assets/layout.json (aquarium, condo) ask for it; snowgoons stays
     without any network permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
