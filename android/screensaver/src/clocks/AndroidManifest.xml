<?xml version="1.0" encoding="utf-8"?>
<!-- WF Clocks (org.worldfoundry.game.clocks): every clock of wflevels/clocks-menu.manifest in one app.
     docs/plans/2026-11-21-tide-harbour-clock.md, "The bundle and the chooser". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner">
        <activity android:name=".ClocksActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ClocksDreamService"
            android:label="@string/clocks_dream_name"
            android:process=":dream"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
            <meta-data android:name="org.worldfoundry.screensaver.SETTINGS_AUTHORITY"
                android:value="${applicationId}.settings" />
        </service>
        <provider android:name=".ClocksSettingsProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true" />
    </application>
</manifest>
