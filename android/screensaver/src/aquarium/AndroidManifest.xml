<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner">
        <activity android:name=".AquariumActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".AquariumDreamService"
            android:process=":dream"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream_chooser" />
            <meta-data android:name="org.worldfoundry.screensaver.SETTINGS_AUTHORITY"
                android:value="${applicationId}.settings" />
            <meta-data android:name="org.worldfoundry.screensaver.PREVIEW_ACTIVITY"
                android:value="org.worldfoundry.screensaver.ScreensaverPreviewActivity" />
            <meta-data android:name="org.worldfoundry.screensaver.PREVIEW_EXTRA"
                android:value="org.worldfoundry.screensaver.DREAM" />
            <meta-data android:name="org.worldfoundry.screensaver.PREVIEW_VALUE"
                android:value="aquarium" />
        </service>
        <!-- The "use for screensaver" chooser the Dream's settingsActivity (@xml/dream_chooser) opens:
             android/screensaver/README.md, "Choosing the screensaver". -->
        <activity android:name=".ScreensaverChooserActivity"
            android:label="@string/chooser_title"
            android:process=":chooser"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
        <provider android:name=".TankSettingsProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true" />
    </application>
</manifest>
