#!/usr/bin/env bash
# Refuse any staged ADDED path whose name contains a printf format specifier.
#
# Such filenames (e.g. auto_%04i.png, frame_%05d.bin) are traps — tools that
# interpolate paths through printf-style formatting (logging, ImageMagick
# -format, ffmpeg -i with sequence detection) will mangle the path and
# silently read the wrong file. See docs/plans/2026-05-05-printf-filename-guard.md
# for the incident that prompted this hook.
#
# --diff-filter=A scopes to NEWLY introduced paths only; existing tracked
# names are grandfathered, so this hook won't fire on every modification of
# a historical file (none today, but future-proofing).
#
# Activate per clone:  git config core.hooksPath scripts/git-hooks
set -euo pipefail

bad=$(git diff --cached --name-only --diff-filter=A \
      | grep -E '%[-+ #0]?[0-9]*[diouxXeEfgGaAcspn]' || true)

if [[ -n "$bad" ]]; then
    echo "ERROR: refusing to commit paths with printf-style format specifiers:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "" >&2
    echo "These are filename traps — tools that interpolate paths through" >&2
    echo "printf-style formatting (logging, ImageMagick -format, ffmpeg -i)" >&2
    echo "will mangle the path. Rename before committing, e.g.:" >&2
    echo "  auto_%04i.png  →  auto_0000.png" >&2
    echo "" >&2
    echo "Bypass (only if you know what you are doing): git commit --no-verify" >&2
    exit 1
fi
