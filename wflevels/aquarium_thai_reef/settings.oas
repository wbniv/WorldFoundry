@* Runtime controls for the Gulf of Thailand reef (plan 2026-11-08 W5): a level
@* settings object owned by the Director, as the Jellyfish and Planted tanks do.
@* Fixed shows the reviewed W3 reef; Random lays out a new one from the seed (W5c).
TYPEHEADER(ReefSettings)
    PROPERTY_SHEET_HEADER(Reef,1)
    TYPEENTRYINT32(Layout,,0,1,1,"Fixed|Random",SHOW_AS_RADIOBUTTONS,"Fixed is the reviewed reef; Random builds a new reef from the seed")
    TYPEENTRYINT32(Rocks,,1,5,3,"1|2|3|4|5",SHOW_AS_SLIDER,"Random layout: how many rock masses stand on the sand")
    TYPEENTRYINT32(Colonies,,0,2,1,"Sparse|Normal|Dense",SHOW_AS_SLIDER,"Random layout: how much attached life grows on the rock")
    TYPEENTRYINT32(Seed,,0,16777215,0,"",SHOW_AS_NUMBER,"Random layout: 0 draws a new reef on every entry; any other value repeats it")
    PROPERTY_SHEET_FOOTER
TYPEFOOTER
