		{ 'FX32' { 'NAME' "Horiz Air Drag" } { 'DATA' 0.0000000000000000(1.15.16) } { 'STR' "0.0" } }
		{ 'FX32' { 'NAME' "Vert Air Drag" } { 'DATA' 0.0000000000000000(1.15.16) } { 'STR' "0.0" } }
		{ 'FX32' { 'NAME' "Max Air Speed" } { 'DATA' 6.0960000000000001(1.15.16) } { 'STR' "6.096" } }
		{ 'FX32' { 'NAME' "Falling Acceleration" } { 'DATA' 0.0000000000000000(1.15.16) } { 'STR' "0.0" } }
