@* Supplemental instance properties; attached to the Planted Tank screensaver Director.
@* Fields 1-7 match wflevels/aquarium_plants/settings.oas (planted::enter() reads them).
@* No Seahorses or Greeting: the screensaver has no animals. Hold seconds is id 10.
@* Legacy TYPEENTRYSTRING emits ignored XData; use the existing BUTTON_STRING
@* descriptor for an explicitly bounded instance text value instead.
@define TYPEENTRYBOUNDEDTEXT(name,count,help) { BUTTON_STRING,"@+name@+",0,count-1,0,count,"",SHOW_AS_NUMBER,-1,-1,help,{0,0,"@+name@+","1"}},
TYPEHEADER(PlantedTankSettings)
    PROPERTY_SHEET_HEADER(Plant growth,1)
    TYPEENTRYBOUNDEDTEXT(Seed,11,"Random number seed from 0 to 4294967295")
    TYPEENTRYINT32(Water type,,0,1,0,"Freshwater|Saltwater",SHOW_AS_RADIOBUTTONS,"Choose the aquatic plant habitat")
    TYPEENTRYINT32(Growth speed,,0,6,3,"Paused|0.25x|0.5x|1x|2x|4x|8x",SHOW_AS_SLIDER,"Changes growth rate without restarting the plants")
    TYPEENTRYFIXED32(Initial age,,0,15728640,0,SHOW_AS_SLIDER,"Authored starting age in seconds; applied on level entry only")
    TYPEENTRYBOOLEAN(Textures,,1,SHOW_AS_CHECKBOX,"Enable textured plant meshes on Apply")
    TYPEENTRYBOOLEAN(Sway,,1,SHOW_AS_CHECKBOX,"Enable plant sway on Apply")
    TYPEENTRYBOOLEAN(Random seed on entry,,1,SHOW_AS_CHECKBOX,"Authored entry policy; disable to use the authored Seed deterministically")
    PROPERTY_SHEET_FOOTER
    PROPERTY_SHEET_HEADER(Screensaver,0)
    TYPEENTRYINT32(Hold seconds,,0,86400,120,"",SHOW_AS_NUMBER,"Seconds a fully grown tank stays on screen before the next tank")
    PROPERTY_SHEET_FOOTER
TYPEFOOTER
