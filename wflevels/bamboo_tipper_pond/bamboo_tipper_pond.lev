* 0.5000000 + * 3.6000000 + else dup 5 < if 4 - dup dup -1.3000000 * 1.6000000 + * 2.7000000 + * 6.0000000 + else 5 - dup dup -0.7500000 * -0.2500000 + * 2.0000000 + * 9.0000000 + then then then then then ;\n: bp-c3 INDEXOF_WALL_SECOND read-mailbox 10 / dup 1 < if dup dup 2.7500000 * -3.3500000 + * -0.9000000 + * 0.7000000 + else dup 2 < if 1 - dup dup -1.8500000 * 4.0000000 + * 0.6500000 + * -0.8000000 + else dup 3 < if 2 - dup dup -2.7000000 * 3.0000000 + * 3.1000000 + * 2.0000000 + else dup 4 < if 3 - dup dup 1.6000000 * -4.0000000 + * 1.0000000 + * 5.4000000 + else dup 5 < if 4 - dup dup 2.1500000 * -2.9500000 + * -2.2000000 + * 4.0000000 + else 5 - dup dup -1.9500000 * 3.3000000 + * -1.6500000 + * 1.0000000 + then then then then then ;\n: bp-c4 INDEXOF_WALL_SECOND read-mailbox 10 / dup 1 < if dup dup -0.7500000 * 1.0000000 + * 0.2500000 + * 0.0000000 + else dup 2 < if 1 - dup dup 0.7500000 * -1.2500000 + * 0.0000000 + * 0.5000000 + else dup 3 < if 2 - dup dup -0.2500000 * 0.5000000 + * -0.2500000 + * 0.0000000 + else dup 4 < if 3 - dup dup 0.0000000 * 0.0000000 + * 0.0000000 + * 0.0000000 + else dup 5 < if 4 - dup dup 0.0000000 * 0.0000000 + * 0.0000000 + * 0.0000000 + else 5 - dup dup 0.2500000 * -0.2500000 + * 0.0000000 + * 0.0000000 + then then then then then ;\n: bp-c5 INDEXOF_WALL_SECOND read-mailbox 10 / dup 1 < if dup dup 0.0500000 * -0.0500000 + * 0.0000000 + * 0.0000000 + else dup 2 < if 1 - dup dup 0.4500000 * -0.4000000 + * 0.0500000 + * 0.0000000 + else dup 3 < if 2 - dup dup -1.4500000 * 1.9500000 + * 0.6000000 + * 0.1000000 + else dup 4 < if 3 - dup dup 1.1500000 * -2.1000000 + * 0.1500000 + * 1.2000000 + else dup 5 < if 4 - dup dup 0.0000000 * 0.2000000 + * -0.6000000 + * 0.4000000 + else 5 - dup dup -0.2000000 * 0.4000000 + * -0.2000000 + * 0.0000000 + then then then then then ;\n: bp-tick\n INDEXOF_WALL_HOUR read-mailbox dup 6 < swap 18 >= | 780 write-mailbox\n bp-hour sin-rev 3.55 * INDEXOF_X_POS 16 write-actor-mailbox\n bp-hour cos-rev 3.55 *