		{ 'STR' 
			{ 'NAME' "Script" 
			}
			{ 'STR' "\\ wf\n"
": DIR-TMPL  11 ;\n"
": FILE-TMPL 12 ;\n"
": COLS  8 ;\n"
": CELL  5 ;\n"
": X0    -17 ;\n"
": Y0    -15 ;\n"
": grid-x ( n -- x ) COLS mod CELL * X0 + ;\n"
": grid-y ( n -- y ) COLS /   CELL * Y0 + ;\n"
": cnt@  11 read-mailbox ;\n"
": cnt+  cnt@ 1 + 11 write-mailbox ;\n"
": isqrt ( n -- s )\n"
"  dup 0 = if else\n"
"    1 swap\n"
"    begin swap 1+ swap over dup * over > until\n"
"    swap drop 1-\n"
"  fi ;\n"
": spawn-dir ( idx -- )\n"
"  cwd-dir-count isqrt dup 1 < if drop 1 fi\n"
"  cnt@ dup grid-x swap grid-y 0 DIR-TMPL spawn-template\n"
"  swap set-scale\n"
"  cnt+ ;\n"
": spawn-file ( idx -- )\n"
"  cwd-file-size 1000 / isqrt dup 1 < if drop 1 fi\n"
"  cnt@ dup grid-x swap grid-y 0 FILE-TMPL spawn-template\n"
"  swap set-scale\n"
"  cnt+ ;\n"
"10 read-mailbox 0 = if\n"
"  1 10 write-mailbox\n"
"  0 11 write-mailbox\n"
"  cwd-scan 0 do\n"
"    i cwd-is-dir if\n"
"      i spawn-dir\n"
"    else\n"
"      i spawn-file\n"
"    fi\n"
"  loop\n"
"fi\n"
""
			}
		}
