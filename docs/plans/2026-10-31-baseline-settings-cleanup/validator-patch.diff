+class Device:
+    """Scripted World Foundry host for the two-owner baseline: Field types (19) and
+    Runtime settings (20, the only Runtime Options owner). One chooser and form serve the
+    TV and the phone; the idle snapshot reports the first editable owner, as on device.
+    `shared_sheet` gives Field types the runtime rows too, as the old owners all had."""
+    OWNERS = [{'actor': 19, 'title': 'Field types'}, {'actor': 20, 'title': 'Runtime settings'}]
+
+    def __init__(self, shared_sheet=False):
+        runtime = {'1000': '1', '1001': '0', '1002': '20', '1003': '0', '1004': '0', '1005': 'On'}
+        self.values = {19: {'1': '120', **(runtime if shared_sheet else {})}, 20: runtime}
+        self.schemas = {19: 'FieldTypes', 20: 'Settings'}
+        self.modal, self.row, self.actor, self.draft = 'none', 0, None, {}
+        self.step, self.time, self.us, self.session = 0, 0.0, 0, 0
+        self.out = None
+
+    def readonly(self, actor, field):
+        return actor == 20 and (field == '1005' or (field in ('1003', '1004') and self.values[20][field] == '1'))
+
+    def open(self, actor):
+        self.actor, self.draft, self.modal = actor, dict(self.values[actor]), 'form'
+        self.session += 1
+
+    def close(self):
+        self.modal, self.actor, self.draft = 'none', None, {}
+
+    def commit(self):
+        self.values[self.actor].update(self.draft)
+        self.close()
+
+    # TV remote
+    def hold(self, adapter, code, ms):
+        if self.modal == 'none':
+            self.modal, self.row = 'object-picker', 0
+            self.session += 1
+
+    def key(self, code):
+        code = code.replace('KEYCODE_', '')
+        if self.modal == 'object-picker':
+            if code == 'DPAD_DOWN':
+                self.row += 1
+            elif code == 'DPAD_CENTER' and self.row >= 1:
+                self.open(self.OWNERS[self.row - 1]['actor'])
+        elif self.modal == 'form':
+            if code == 'DPAD_LEFT' and self.actor == 20:
+                self.draft['1000'] = '0'  # Show FPS has focus: first row of the first section
+            elif code == 'BACK':
+                self.commit()
+
+    # Diagnostics bridge
+    def snapshot(self, **kwargs):
+        paused = self.modal != 'none'
+        if not paused:
+            r = self.values[20]
+            delta = 1 / int(r['1002']) if r['1001'] == '1' else .6
+            self.step += 1; self.time += delta; self.us += 600000
+        else:
+            delta = None
+        actor = self.actor or 19
+        fields = [{'field': int(k), 'committed': v, 'draft': self.draft.get(k, v)} for k, v in self.values[actor].items()]
+        return {'run': 'process', 'level_generation': 1, 'simulation_step': self.step, 'monotonic_us': self.us,
+                'player': {'actor': 4},
+                'game': {'mode': 'game', 'paused': paused, 'modal': self.modal, 'simulation_time': self.time,
+                         'simulation_delta': delta if delta is not None else 0},
+                'properties': {'schema': self.schemas[actor], 'actor': actor, 'fields': fields}}
+
+    # Phone
+    def model(self):
+        if self.modal == 'object-picker':
+            return {'session': self.session, 'open': True, 'picker': True, 'objects': self.OWNERS, 'fields': []}
+        if self.modal == 'form':
+            return {'session': self.session, 'open': True, 'error': '', 'fields': [
+                {'id': int(k), 'kind': 0, 'value': v, 'readonly': self.readonly(self.actor, k)} for k, v in self.draft.items()]}
+        return {'session': self.session, 'open': False, 'fields': []}
+
+    def command(self, model, verb, tail=None):
+        if verb == 'select':
+            self.open(int(tail))
+        elif verb == 'set':
+            field, value = tail.split(':', 1)
+            if not self.readonly(self.actor, field):
+                self.draft[field] = value
+        elif verb == 'apply':
+            self.commit()
+        elif verb == 'cancel':
+            self.close()
+
+    def capture(self, name):
+        if name == 'profilers-running-':
+            (self.out / 'profilers-running-logcat.txt').write_text('frame-profile: total 3 ms\n')
+            (self.out / 'profilers-running-wf.log').write_text('old run\n=== wf_game android_main\nscript-profile: actor 20\n')
+
+
+def run_device(device, tmp_path, monkeypatch):
+    from types import SimpleNamespace
+    import wf_device.plugins.android.validators.runtime_options_checks as checks
+    class Bridge:
+        def __init__(self, adapter): pass
+        snapshot = staticmethod(device.snapshot)
+        def close(self): pass
+    class Phone:
+        def __init__(self, adapter): pass
+        def model(self, predicate=lambda m: True):
+            m = device.model()
+            if not predicate(m):
+                raise RuntimeError('Timed out waiting for expected property snapshot')
+            return m
+        def send(self, text):
+            if text == 'r:open':
+                device.hold(None, '23', 0)
+        command = staticmethod(device.command)
+        def close(self): pass
+    monkeypatch.setattr(checks, 'Bridge', Bridge)
+    monkeypatch.setattr(checks, 'Phone', Phone)
+    monkeypatch.setattr(checks, 'hold', device.hold)
+    device.out = tmp_path
+    adapter = SimpleNamespace(out=tmp_path, key=device.key, wait=lambda s: None, capture=device.capture,
+                              require_foreground=lambda: None)
+    checks.check_runtime_options(adapter)
+
+
+def test_two_owner_full_sequence(tmp_path, monkeypatch):
+    import json
+    device = Device()
+    run_device(device, tmp_path, monkeypatch)
+    report = json.loads((tmp_path / 'runtime-options-checks.json').read_text())
+    assert all(report['assertions'].values())
+    assert list(report['assertions']) == [
+        'baseline_catalog', 'actual_clock_readback', 'tv_opens_runtime_settings', 'default_fps_and_realtime',
+        'tv_draft_has_no_effect', 'two_owners', 'tv_back_applies_fps', 'phone_draft_has_no_effect',
+        'cancel_keeps_realtime', 'actual_fixed_clock_20', 'actual_fixed_clock_37', 'field_types_unaffected',
+        'reopened_owner_reads_process_globals', 'actual_realtime_clock', 'active_profilers_readonly',
+        'renderer_ghost_readonly', 'actual_frame_profile_output', 'actual_script_profile_output']
+    assert [c['hz'] for c in report['clock_measurements']] == [20, 37]
+    assert device.values[19] == {'1': '120'}
+
+
+def test_runtime_rows_on_field_types_fail_and_save_report(tmp_path, monkeypatch):
+    import json
+    with pytest.raises(RuntimeError, match='field_types_unaffected'):
+        run_device(Device(shared_sheet=True), tmp_path, monkeypatch)
+    report = json.loads((tmp_path / 'runtime-options-checks.json').read_text())
+    assert report['assertions']['two_owners'] is True
+    assert report['assertions']['field_types_unaffected'] is False
+    assert 'reopened_owner_reads_process_globals' not in report['assertions']
