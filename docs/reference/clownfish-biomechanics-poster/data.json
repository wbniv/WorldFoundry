   "opened": true,
   "backs": "damselfish, 12 species, no clownfish: gait switch at 1.87–4.95 BL/s (a hint only)"
  },
  "S6": {
   "cite": "Li, Ashraf, François, Kolomenskiy, Lechenault, Godoy-Diana & Thiria 2021, Commun. Biol. 4:40",
   "title": null,
