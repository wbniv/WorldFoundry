+"""Fixed baseline catalog, remote input and lifecycle acceptance in one lease."""
+import json
+import time
+from .diagnostics import Bridge
+from .plant_checks import Phone, values
+
+
+def check_baseline(a):
+    bridge=phone=None
+    checks={};samples=[];models=[]
+    def check(condition,name):
+        checks[name]=bool(condition)
+        if not condition:raise RuntimeError('Baseline assertion failed: '+name)
+    def snap(label,**kwargs):
+        result=bridge.snapshot(**kwargs);samples.append({'label':label,'snapshot':result});return result
+    def wait(label,predicate,**kwargs):
+        deadline=time.monotonic()+8
+        while time.monotonic()<deadline:
+            result=snap(label,**kwargs)
+            if predicate(result):return result
+            a.wait(.1)
+        raise RuntimeError('Baseline state not reached: '+label)
+    def tap(code):a.key('KEYCODE_'+code);a.wait(.2)
+    def hold(code,ms):a.shell('input','keycombination','-t',str(ms),code,'59');a.wait(.3)
+    def model(predicate=lambda m:True):
+        result=phone.model(predicate);models.append(result);return result
+    try:
+        bridge=Bridge(a)
+        initial=wait('ready',lambda s:s['player'] and s['game']['mode']=='game' and not s['game']['paused'])
+        check(initial['properties']['schema']=='BaselineSettings','baseline_catalog_attached')
+        pos=initial['player']['position'];check(abs(pos[0])<.1 and abs(pos[1]+5)<.1 and .85<pos[2]<1.05,'grounded_spawn')
+        hold('19',2200)
+        moved=snap('held-up-released',since_input=initial['input']['received'])
+        check(moved['player']['position'][1]>pos[1]+.5,'hardware_up_moves_positive_y')
+        history=moved['input']['history']
+        check(any(e['source']=='hardware' and e['pressed']&2048 for e in history) and any(e['source']=='hardware' and e['released']&2048 for e in history),'hardware_press_release_received')
+        a.wait(1);settled=snap('settled')
+        check(not settled['input']['held'] and sum(v*v for v in settled['player']['velocity'])<.05,'released_input_settles')
+        for code in ['20','22','21']:
+            hold(code,800);current=snap('held-released-'+code)
+            check(not current['input']['held'],'released_direction_'+code)
+        # Opening OK is consumed by the picker until its release.
+        hold('23',1500)
+        picker=wait('tv-picker',lambda s:s['game']['modal']=='object-picker')
+        check(picker['game']['paused'],'picker_pauses_simulation')
+        a.capture('tv-picker-')
+        tap('DPAD_DOWN');tap('DPAD_CENTER')
+        form=wait('tv-owner-form',lambda s:s['game']['modal']=='form',draft=True)
+        check(form['properties']['edit']['open'] and form['properties']['actor']!=initial['properties']['actor'],'tv_selects_second_owner')
+        a.capture('tv-form-');tap('BACK');wait('tv-closed',lambda s:s['game']['modal']=='none')
+        phone=Phone(a);model();phone.send('r:open');picker_model=model(lambda m:m.get('picker'))
+        owners=picker_model['objects'];check(len(owners)==2 and owners[0]['actor']<owners[1]['actor'],'stable_two_owner_picker')
+        first,second=[str(o['actor']) for o in owners]
+        phone.command(picker_model,'select',second);edited=model(lambda m:m['open'] and not m.get('picker'))
+        stale=picker_model['session'];phone.send('r:'+str(stale)+':set:40:9');a.wait(.3)
+        check(values(model(lambda m:not m.get('picker')))['40']=='-3','stale_picker_session_ignored')
+        phone.command(edited,'set','40:8');phone.command(edited,'set','64:0.5');phone.command(edited,'set','70:Device%20baseline')
+        edited=model(lambda m:values(m).get('40')=='8' and values(m).get('64')=='0.5' and values(m).get('70')=='Device baseline')
+        a.capture('phone-draft-');phone.command(edited,'apply');model(lambda m:not m['open'])
+        phone.send('r:open');picker_model=model(lambda m:m.get('picker'));phone.command(picker_model,'select',first)
+        original=model(lambda m:m['open'] and not m.get('picker'))
+        check(values(original)['40']=='-3' and values(original)['70']=='Baseline','other_instance_unchanged')
+        phone.command(original,'set','40:13');invalid=model(lambda m:values(m).get('40')=='13');phone.command(invalid,'apply')
+        invalid=model(lambda m:m['open'] and bool(m['error']));session=invalid['session']
+        phone.close();phone=None;a.wait(.8);a.capture('disconnected-draft-')
+        phone=Phone(a);reconnected=model(lambda m:m['open'] and m['session']==session)
+        check(values(reconnected)['40']=='13' and bool(reconnected['error']),'reconnect_preserves_invalid_draft')
+        phone.command(reconnected,'cancel');model(lambda m:not m['open']);phone.send('r:open');picker_model=model(lambda m:m.get('picker'))
+        phone.command(picker_model,'select',second);saved=model(lambda m:m['open'] and not m.get('picker'))
+        check(values(saved)['40']=='8' and values(saved)['64']=='0.5','apply_readback')
+        phone.command(saved,'set','40:7');model(lambda m:values(m).get('40')=='7');phone.close();phone=None
+        process=a.shell('pidof',a.package).strip();a.key('KEYCODE_HOME');a.wait(1)
+        a.shell('am','start','-W','-n',a.activity());a.wait(2);a.dismiss_panel()
+        resumed=wait('resumed',lambda s:not s['game']['suspended'] and s['game']['modal']=='none')
+        check(a.shell('pidof',a.package).strip()==process,'home_resume_same_process')
+        check(not resumed['input']['held'],'home_resume_releases_input')
+        phone=Phone(a);model();phone.send('r:open');picker_model=model(lambda m:m.get('picker'));phone.command(picker_model,'select',second)
+        saved=model(lambda m:m['open'] and not m.get('picker'))
+        check(values(saved)['40']=='8','home_cancels_uncommitted_draft')
+        phone.command(saved,'cancel');model(lambda m:not m['open']);phone.send('b:801');a.wait(.25);phone.send('b:0');a.wait(.6)
+        reset=snap('remote-reset-chord');pos=reset['player']['position']
+        check(abs(pos[0])<.1 and abs(pos[1]+5)<.1 and .85<pos[2]<1.05,'reset_chord_without_settings_or_jump')
+        check(reset['game']['modal']=='none','reset_chord_keeps_gameplay')
+        a.capture('final-');a.require_foreground()
+    finally:
+        if phone:phone.close()
+        if bridge:bridge.close()
+        (a.out/'baseline-checks.json').write_text(json.dumps({'assertions':checks,'snapshots':samples,'phone_models':models},indent=2)+'\n')
