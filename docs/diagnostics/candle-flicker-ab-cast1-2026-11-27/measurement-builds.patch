@@ -0,0 +1,31 @@
+"""The candle study capture must really warm up before it takes frames (candle flicker plan, verification step 0, 2026-11-27).
+
+scripts/capture-candle-study.py waited for each frame step by watching the level clock. With no clock reading yet (NaN) it took the step as
+done, so its 60-frame warm-up was one frame: the level's eased camera was still flying in from the orbit when the frames were taken, and the
+picture looked about 21 degrees off the study pose. A NaN reading must never count as arrival.
+"""
+import importlib.util
+import math
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "capture-candle-study.py"
+
+
+def load():
+    spec = importlib.util.spec_from_file_location("capture_candle_study", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_a_missing_clock_reading_is_never_arrival():
+    m = load()
+    assert not m.stepped(math.nan, 5.0, 60)
+    assert not m.stepped(1.0, math.nan, 1)
+
+
+def test_arrival_needs_the_frames_to_have_run():
+    m = load()
+    assert not m.stepped(1.0, 2.0, 60)          # 30 frames of 60
+    assert m.stepped(1.0, 2.9, 60)              # 57 frames: inside the 10 % slack
+    assert m.stepped(0.0, 1 / 30, 1)
