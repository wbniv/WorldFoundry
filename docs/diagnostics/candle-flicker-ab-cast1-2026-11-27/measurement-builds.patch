+
+# Option B of the flicker plan (measurement builds only; a DFRM mesh a tree, ten curves): the same drive as a smooth value u = clamp(drive / 1.4, -1, 1);
+# a curve's scale is SCALE0 + SPAN u (0.67 to 1.0: the mesh is authored at its tallest) and its flex bias FLEX_DEG u degrees.
+FLICKER_SCALE0, FLICKER_SCALE_SPAN, FLICKER_FLEX_DEG = 0.835, 0.165, 5.0
+
+
+def flame_u(t: float, group_index: int) -> float:
+    return max(-1.0, min(1.0, flame_drive(t, group_index) / 1.4))
+
+
+def deform_cells(t: float, tree: int, curve: int):
+    """(scale, flex bias in degrees) of curve `curve` (0 to 9; its group is curve mod 2) of tree `tree` at t seconds into the minute."""
+    u = flame_u(t, 2 * tree + curve % 2)
+    return FLICKER_SCALE0 + FLICKER_SCALE_SPAN * u, FLICKER_FLEX_DEG * u
