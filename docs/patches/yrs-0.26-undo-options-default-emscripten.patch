# WF local patch for the vendored y-crdt submodule (upstream y-crdt/y-crdt @ 5238955, yrs 0.26.0).
# Purpose: enable `yrs::undo::Options::default()` on wasm32-unknown-emscripten so yffi's
# `yundo_manager` (and the wf-edit web build) cross-compiles. Upstream gates the impl on
# `not(target_family = "wasm")`, which over-broadly excludes emscripten even though its only
# dependency (SystemClock, sync/time.rs) is gated the narrower `not(all(wasm, os=unknown))`
# and IS present on emscripten. Apply from the submodule root:
#   git -C wftools/y-crdt apply docs/patches/yrs-0.26-undo-options-default-emscripten.patch
# Applied idempotently by: task dev-setup-web-edit
#
diff --git a/yrs/src/undo.rs b/yrs/src/undo.rs
index 63222e7..c96e742 100644
--- a/yrs/src/undo.rs
+++ b/yrs/src/undo.rs
@@ -76,7 +76,11 @@ where
