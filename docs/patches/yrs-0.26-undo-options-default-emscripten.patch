     /// type and document. While it's possible for undo manager to observe multiple shared types
     /// (see: [UndoManager::expand_scope]), it can only work with a single document at the same time.
-    #[cfg(not(target_family = "wasm"))]
+    // WF local patch: was `not(target_family = "wasm")`, which also excluded
+    // emscripten even though its only dependency, Options::default()/SystemClock,
+    // is available there (see sync/time.rs gate). Aligned with the SystemClock
+    // gate so wasm32-unknown-emscripten (the web editor target) can build.
+    #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
     pub fn new<T>(doc: &Doc, scope: &T) -> Self
     where
         T: AsRef<Branch>,
@@ -889,7 +893,12 @@ pub struct Options<M> {
 
 pub type CaptureTransactionFn = Arc<dyn Fn(&TransactionMut) -> bool + Send + Sync + 'static>;
 
-#[cfg(not(target_family = "wasm"))]
