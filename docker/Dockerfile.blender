# Level-build image for World Foundry: Foundry Linux's Blender, as on the host, so the
# `blender --background` asset generation in wflevels/*/build.sh runs in a reproducible
# place instead of on a developer's machine. Plan: docs/plans/2026-10-16-blender-in-container.md.
#
# The host is Foundry Linux on Ubuntu 26.04 ("resolute"): its Blender is Ubuntu's
# blender package, pulled in by worldfoundry-blender-addons (foundrylinux.org,
# foundry-devbox/Dockerfile). This image installs the same packages at the same
# versions, so Blender runs on the same Python 3.14, numpy, Pillow and glibc as the host.
# (Ubuntu 24.04, the test image's base, only carries Blender 4.0.2; the official
# Blender tarball bundles its own Python 3.11, whose float sums and compiled maths
# differ in the last bit from the host's.)
#
# Every package comes from one Ubuntu archive snapshot (snapshot.ubuntu.com), so the
# pinned versions cannot disappear when resolute moves on. Bump the snapshot and the
# pins together, to what `apt-cache policy blender python3-numpy python3-pil` shows on
# an up-to-date host. scripts/in-linux-container.sh builds it on first use
# (WF_CONTAINER_IMAGE=blender), or run `task blender-image`.
#
# It starts from the lab's Ubuntu 26.04 build stack (home-lab stack-build-ubuntu, which
# carries build-essential, ca-certificates, git, pkg-config and python3), not from bare
# ubuntu:26.04: the base stays Ubuntu 26.04 for host parity. That registry is reachable
# only inside the lab, so this image builds only there; elsewhere use
# docker/Dockerfile.blender.public (`task blender-image-public`), which gives the same image
# from `FROM ubuntu:26.04`. Keep the pins in both files identical.
FROM registry.lab.home.arpa:5000/stacks/stack-build-ubuntu@sha256:a1965142d6f3edec29bb12ea456e26c62a3dab12ca0d36e4411acb16d6718e65

ENV DEBIAN_FRONTEND=noninteractive
# The stack ends as user dev; this image ran as root, and the Rust install below writes
# to /opt, so it stays root as before (in-linux-container.sh runs it with --user anyway).
USER root
ARG UBUNTU_SNAPSHOT=20261016T000000Z
ARG BLENDER_DEB=5.0.1+dfsg-1ubuntu1
ARG NUMPY_DEB=1:2.3.5+ds-3ubuntu1
ARG PIL_DEB=12.1.1-2ubuntu1.3
# snapshot.ubuntu.com is HTTPS-only; the stack already carries ca-certificates.
RUN apt-get update --snapshot "${UBUNTU_SNAPSHOT}" \
 && apt-get install -y --no-install-recommends --snapshot "${UBUNTU_SNAPSHOT}" \
      "blender=${BLENDER_DEB}" "python3-numpy=${NUMPY_DEB}" "python3-pil=${PIL_DEB}" \
 && rm -rf /var/lib/apt/lists/*

# The Rust level tools (iffcomp, levcomp, textile, oas2oad, wf_core) build from the
# repo with the same pinned toolchain as docker/Dockerfile.linux-test.
ENV RUSTUP_HOME=/opt/rustup
RUN python3 -c "import urllib.request as u; u.urlretrieve('https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init', '/tmp/rustup-init')" \
 && chmod +x /tmp/rustup-init \
 && CARGO_HOME=/opt/cargo /tmp/rustup-init -y --profile minimal --default-toolchain 1.85.1 --no-modify-path \
 && rm /tmp/rustup-init \
 && chmod -R a+rX /opt/rustup /opt/cargo
ENV PATH=/opt/cargo/bin:$PATH \
    CARGO_HOME=/tmp/cargo

# The wf_blender add-on is loaded from the mounted checkout, never baked in, so an
# add-on edit needs no image rebuild: Blender's system scripts path gets an addons/
# entry that points at /src/wftools/wf_blender (dangling until the repo is mounted).
RUN mkdir -p /opt/wf-blender-scripts/addons \
 && ln -s /src/wftools/wf_blender /opt/wf-blender-scripts/addons/wf_blender
ENV BLENDER_SYSTEM_SCRIPTS=/opt/wf-blender-scripts \
    WF_IN_CONTAINER=blender \
    HOME=/tmp
WORKDIR /src
