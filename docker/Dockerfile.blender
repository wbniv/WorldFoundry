# Level-build image for World Foundry: the Linux test image (docker/Dockerfile.linux-test,
# with its pinned Rust toolchain, Python and Xvfb) plus a pinned Blender, so the
# `blender --background` asset generation in wflevels/*/build.sh runs in the same
# reproducible place as the rest of the build instead of on a developer's host.
# Plan: docs/plans/2026-10-16-blender-in-container.md.
#
# Built FROM the local test image, so its layers are shared and only Blender is added
# (~1.3 GB unpacked). scripts/in-linux-container.sh builds both on first use
# (WF_CONTAINER_IMAGE=blender), or run `task blender-image`.
FROM wf-linux-test:local

# Runtime libraries the official Blender Linux build loads even in --background:
# X11 client libs, xkbcommon, EGL/Wayland stubs, SM/ICE. xz-utils unpacks the tarball.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      xz-utils \
      libxi6 libxxf86vm1 libxfixes3 libxrender1 libxkbcommon0 libxkbcommon-x11-0 \
      libsm6 libice6 libegl1 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
      libdecor-0-0 \
 && rm -rf /var/lib/apt/lists/*

# Blender 5.0.1, the official Linux x64 build, checked against the sha256 that
# download.blender.org publishes in blender-5.0.1.sha256. Bump both together.
ARG BLENDER_VERSION=5.0.1
ARG BLENDER_SHA256=8019580ee1b7262e505f4196a00237ccf743c88d205b38d34201510676e60b09
# download.blender.org answers Python's default User-Agent with 403; any ordinary one gets the file.
RUN python3 -c "import shutil, urllib.request as u; r = u.urlopen(u.Request('https://download.blender.org/release/Blender${BLENDER_VERSION%.*}/blender-${BLENDER_VERSION}-linux-x64.tar.xz', headers={'User-Agent': 'wf-blender-image'})); shutil.copyfileobj(r, open('/tmp/blender.tar.xz', 'wb'))" \
 && echo "${BLENDER_SHA256}  /tmp/blender.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/blender \
 && tar -xJf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
 && rm /tmp/blender.tar.xz \
 && ln -s /opt/blender/blender /usr/local/bin/blender

# The generators import Pillow (textures); host Blender gets it from the system Python,
# the official build's bundled Python has none. Pinned to the host's version (12.1.1).
ARG PILLOW_VERSION=12.1.1
RUN /opt/blender/${BLENDER_VERSION%.*}/python/bin/python3.11 -m ensurepip \
 && /opt/blender/${BLENDER_VERSION%.*}/python/bin/python3.11 -m pip install --no-cache-dir --only-binary=:all: "Pillow==${PILLOW_VERSION}"

# The wf_blender add-on is loaded from the mounted checkout, never baked in, so an
# add-on edit needs no image rebuild: Blender's system scripts path gets an addons/
# entry that points at /src/wftools/wf_blender (dangling until the repo is mounted).
RUN mkdir -p /opt/wf-blender-scripts/addons \
 && ln -s /src/wftools/wf_blender /opt/wf-blender-scripts/addons/wf_blender
ENV BLENDER_SYSTEM_SCRIPTS=/opt/wf-blender-scripts \
    WF_IN_CONTAINER=blender
