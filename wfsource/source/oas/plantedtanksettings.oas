@*============================================================================
@* plantedtanksettings.oas: the planted tank's level settings
@*============================================================================
@*
@* A settings holder (settings.inc): one object of this type in a planted tank
@* level carries the tank's options, and levcomp lists it as editable because
@* it declares SHOW_AS_LIVE fields (docs/plans/2026-10-16-runtime-object-
@* editing.md, M7, M8). A live field is one the engine re-reads after the level
@* loads, so a runtime edit takes effect; the rest show read-only.
@*
@* Declared only, as of Phase 1: no level places one yet. Phase 3 migrates the
@* planted tank from its RP01 catalog (wflevels/aquarium_plants/settings.oas)
@* to this type. Until a level ships with it, fields may still change; after
@* that, append new fields at the end only.
@*
@* Help strings must not contain commas: prep splits macro arguments on them.
@*============================================================================

TYPEHEADER(Planted Tank Settings,PlantedTankSettings)
	@include settings.inc

	PROPERTY_SHEET_HEADER(Plant growth,1)
@*	-------------------------------------
@*	Seed: INT32 capped at 2^31-1 (M4); larger saved values are clamped (R7).
	TYPEENTRYINT32(Seed,,0,2147483647,0,"",SHOW_AS_NUMBER|SHOW_AS_LIVE,"Random number seed from 0 to 2147483647")
	TYPEENTRYINT32(Water type,,0,1,0,"Freshwater|Saltwater",SHOW_AS_RADIOBUTTONS|SHOW_AS_LIVE,"Choose the aquatic plant habitat and resident")
	TYPEENTRYINT32(Growth speed,,0,6,3,"Paused|0.25x|0.5x|1x|2x|4x|8x",SHOW_AS_SLIDER|SHOW_AS_LIVE,"Changes growth rate without restarting the plants")
	TYPEENTRYFIXED32(Initial age,,0,15728640,0,SHOW_AS_SLIDER,"Authored starting age in seconds; applied on level entry only")
	TYPEENTRYBOOLEAN(Textures,,1,SHOW_AS_CHECKBOX|SHOW_AS_LIVE,"Enable textured plant meshes on Apply")
	TYPEENTRYBOOLEAN(Sway,,1,SHOW_AS_CHECKBOX|SHOW_AS_LIVE,"Enable plant sway on Apply")
	TYPEENTRYBOOLEAN(Random seed on entry,,1,SHOW_AS_CHECKBOX,"Authored entry policy; disable to use the authored Seed deterministically")
	PROPERTY_SHEET_FOOTER

	PROPERTY_SHEET_HEADER(Seahorses,0)
@*	----------------------------------
	TYPEENTRYINT32(Seahorses,,0,6,6,"None|1 pair|2 pairs|3 pairs|4 pairs|5 pairs|6 pairs",SHOW_AS_RADIOBUTTONS|SHOW_AS_LIVE,"Saltwater only: how many seahorse pairs live in the tank")
	TYPEENTRYBOOLEAN(Greeting,,1,SHOW_AS_CHECKBOX|SHOW_AS_LIVE,"Saltwater only: pairs meet on one post for about two minutes")
	PROPERTY_SHEET_FOOTER

	PROPERTY_SHEET_HEADER(Screensaver,0)
	TYPEENTRYINT32(Hold seconds,,0,86400,120,"",SHOW_AS_NUMBER|SHOW_AS_LIVE,"Seconds a fully grown tank stays on screen before the next tank")
	PROPERTY_SHEET_FOOTER

TYPEFOOTER

@*============================================================================
