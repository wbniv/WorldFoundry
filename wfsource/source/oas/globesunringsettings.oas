@* Live settings for the Globe in a 24-hour Sun Ring.
TYPEHEADER(Globe Sun Ring Settings,GlobeSunRingSettings)
	@include settings.inc
	@include clocksettings.inc
	PROPERTY_SHEET_HEADER(Globe,1)
	TYPEENTRYINT32(City lights,,0,1,1,"",SHOW_AS_CHECKBOX|SHOW_AS_LIVE,"Show city lights on the night side")
	PROPERTY_SHEET_FOOTER
	@include global_settings.inc
TYPEFOOTER
