//=============================================================================
// gfx/authored_view.hp: the view a level's authored frame needs on any screen
// Copyright ( c ) 2026 World Foundry Group
// Part of the World Foundry 3D video game engine/production environment
// for more information about World Foundry, see www.worldfoundry.org
//=============================================================================
// Every projection site (gfx/gl/display.cc, hal/ios/display_ios.cc,
// hal/macos/display_macos.cc) asks view() for the vertical field of view, the
// projection aspect and the viewport rectangle, instead of hard-coding 60°.
//
// Two level settings drive it, both 0 (off) by default, so a level that sets
// neither renders exactly as before: 60° vertical, aspect = width / height,
// the whole surface.
//
//   Authored aspect A0 (the shape the level's shots were composed in, 1.778 for
//   16:9). A screen at least that wide keeps the 60° vertical view and shows
//   more at the sides; a narrower screen keeps the authored horizontal view,
//   2·atan(tan(30°)·A0), and shows more above and below. The authored frame is
//   always the visible region's central A0-shaped part. Pixels stay square.
//
//   Maximum aspect M. A screen wider than M draws the picture at aspect M,
//   centred at full height, with black bars at the sides (a pillarbox): nothing
//   beyond what M shows is ever drawn. Independent of A0.
//
// The level sets both when it loads (game/level.cc, LevelRenderSettings
// "Authored aspect" and "Maximum aspect"). The runtime arguments
// --authored-aspect=N and --maximum-aspect=N override the level: a test and
// override path, so CI can prove the view on a published level that predates
// the settings. Plan: finding-your-way docs/plans/2026-11-02-fill-screen-keep-
// authored-frame.md. Header-only and platform-free; CTest authored_view.
//=============================================================================

#ifndef _WF_GFX_AUTHORED_VIEW_HP
#define _WF_GFX_AUTHORED_VIEW_HP

#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace wfview
{

constexpr float kVerticalFovDegrees = 60.0f;   // the engine's view since it began

struct View
{
    float verticalFov;     // degrees, for SetProjection
    float aspect;          // projection aspect: the drawn rectangle's width / height
    int   x, y, width, height;   // the drawn rectangle in surface pixels (bottom-left origin for GL;
                                 // centred, so the same numbers serve Metal's top-left origin)
    bool  pillarbox;       // the screen is wider than the maximum: clear all, draw only the rectangle
    float HorizontalFov() const
    {
        const double d2r = 3.14159265358979323846 / 180.0;
        return float(2.0 * std::atan(std::tan(verticalFov * 0.5 * d2r) * aspect) / d2r);
    }
};

inline View
view(int width, int height, float authoredAspect, float maximumAspect)
{
    if (height <= 0) height = 1;
    if (width <= 0) width = 1;
    View v;
    v.verticalFov = kVerticalFovDegrees;
    v.x = 0; v.y = 0; v.width = width; v.height = height;
    v.pillarbox = false;
    // Off: exactly the expression every site used before, bit for bit.
    v.aspect = float(width) / float(height);

    if (maximumAspect > 0.0f && v.aspect > maximumAspect)
    {
        int w = int(std::lround(double(height) * maximumAspect));
        if (w < 1) w = 1;
        if (w > width) w = width;
        v.x = (width - w) / 2;
        v.width = w;
        v.pillarbox = true;
        v.aspect = float(w) / float(height);
    }
    if (authoredAspect > 0.0f && v.aspect < authoredAspect)
    {
        // Keep the authored horizontal view; grow the vertical one.
        const double d2r = 3.14159265358979323846 / 180.0;
        const double t = std::tan(kVerticalFovDegrees * 0.5 * d2r) * authoredAspect / v.aspect;
        v.verticalFov = float(2.0 * std::atan(t) / d2r);
    }
    return v;
}

// What the level asked for, and what the runtime arguments override it with
// (a negative value means "not given").
struct Settings
{
    float authoredAspect = 0.0f;
    float maximumAspect  = 0.0f;
};

inline Settings& levelSettings()    { static Settings s; return s; }
inline Settings& argumentOverrides() { static Settings s{-1.0f, -1.0f}; return s; }

inline Settings effective()
{
    Settings s = levelSettings();
    const Settings& o = argumentOverrides();
    if (o.authoredAspect >= 0.0f) s.authoredAspect = o.authoredAspect;
    if (o.maximumAspect  >= 0.0f) s.maximumAspect  = o.maximumAspect;
    return s;
}

inline bool active()
{
    const Settings s = effective();
    return s.authoredAspect > 0.0f || s.maximumAspect > 0.0f;
}

inline View current(int width, int height)
{
    const Settings s = effective();
    return view(width, height, s.authoredAspect, s.maximumAspect);
}

// Where the effective settings came from, for the VIEW line: "default",
// "level" or "argument". game/level.cc sets it when a level loads.
inline const char*& source() { static const char* s = "default"; return s; }

// Writes the VIEW line (no newline) for the view applied to a width x height
// surface with the effective settings, for example on the iPad:
//   VIEW authored=1.778 screen=1.333 hfov=91.5 vfov=75.2 maximum=2.250
//        surface=2752x2064 viewport=0,0,2752x2064 pillarbox=0 source=argument
inline int formatLine(char* buf, std::size_t n, int width, int height)
{
    const Settings s = effective();
    const View v = view(width, height, s.authoredAspect, s.maximumAspect);
    return std::snprintf(buf, n,
        "VIEW authored=%.3f screen=%.3f hfov=%.1f vfov=%.1f maximum=%.3f surface=%dx%d "
        "viewport=%d,%d,%dx%d pillarbox=%d source=%s",
        s.authoredAspect, double(width) / double(height), v.HorizontalFov(), v.verticalFov,
        s.maximumAspect, width, height, v.x, v.y, v.width, v.height, v.pillarbox ? 1 : 0, source());
}

// Logs the VIEW line when the view applied differs from the one last logged
// (surface size, settings or source); true when it logged. Each projection site
// calls it with the size it actually applies, so the line follows the real
// surface. A level can load before the platform knows that size: on iOS the
// first viewWillLayoutSubviews can land after it, and the size until then is
// the Display's 800x600 fallback (Codemagic build 6ae7e5ed, iPhone 17 Pro).
// A one-shot line at level load reported that fallback while the picture,
// rebuilt on the next frame, was right.
inline bool report(int width, int height)
{
    if (width <= 0 || height <= 0) return false;
    static int lastW = 0, lastH = 0;
    static Settings lastS{-1.0f, -1.0f};
    static const char* lastSource = nullptr;
    const Settings s = effective();
    if (width == lastW && height == lastH && s.authoredAspect == lastS.authoredAspect &&
        s.maximumAspect == lastS.maximumAspect && source() == lastSource)
        return false;
    lastW = width; lastH = height; lastS = s; lastSource = source();
    char line[256];
    formatLine(line, sizeof line, width, height);
    std::fprintf(stderr, "%s\n", line);
    return true;
}

// Parses "--authored-aspect=N" / "--maximum-aspect=N"; true when the argument
// was one of them (a malformed or negative number is reported and ignored).
inline bool parseArgument(const char* arg)
{
    static const char kA[] = "--authored-aspect=", kM[] = "--maximum-aspect=";
    float* target = nullptr; const char* value = nullptr;
    if (std::strncmp(arg, kA, sizeof(kA) - 1) == 0) { target = &argumentOverrides().authoredAspect; value = arg + sizeof(kA) - 1; }
    else if (std::strncmp(arg, kM, sizeof(kM) - 1) == 0) { target = &argumentOverrides().maximumAspect; value = arg + sizeof(kM) - 1; }
    else return false;
    char* end = nullptr;
    const float f = std::strtof(value, &end);
    if (end == value || *end != '\0' || !(f >= 0.0f) || !std::isfinite(f))
        std::fprintf(stderr, "wf_game: ignoring %s (want a number >= 0; 0 is off)\n", arg);
    else
        *target = f;
    return true;
}

}  // namespace wfview

#endif
