inline void
_RMUV::Validate() const
{
#if DO_ASSERTIONS
	assert(nFrame < 100);			// kts arbitrary
	assert(strlen(szTextureName) < 	TEXTURE_NAME_LENGTH+1);
	// Was hardcoded 1024/512 (matched the legacy Display::VRAM* defaults);
	// use the runtime values so levels that bump VRAM via --vram-* don't
	// trip these asserts. See
	// docs/plans/2026-05-30-runtime-vram-cli-overrides.md.
	RangeCheck(0,u,Display::VRAMWidth);
	RangeCheck(0,v,Display::VRAMHeight);
	RangeCheck(0,w,Display::VRAMWidth);
	RangeCheck(0,h,Display::VRAMHeight);
	if(palx != -1)
		RangeCheck(0,palx,Display::VRAMWidth);
	if(paly != -1)
		RangeCheck(0,paly,Display::VRAMHeight);
#endif
}

//==============================================================================

inline void
RMUV::Validate() const
{
#if DO_ASSERTIONS
	if(_nEntries)
	{
		RangeCheckExclusive(0,_nEntries,100);  // kts arbitrary
		assert(ValidPtr(_tblRMUV));
		for(int rmuvIndex=0;rmuvIndex<_nEntries;rmuvIndex++)
		{
			_tblRMUV[rmuvIndex].Validate();
		}
	}
	else
		assert(_tblRMUV == NULL);
#endif
}

//==============================================================================

inline
RMUV::RMUV()
{
	_nEntries = 0;
	_tblRMUV = NULL;
	Validate();
}

//==============================================================================

inline int
RMUV::NumEntries() const
{
	Validate();
	return _nEntries;
}

