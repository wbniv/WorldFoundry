#include <memory>
#include <vector>
#include <renderassets/lionfish_deform.h>
#include <renderassets/dfrm_deform.h>
// deal only in tri's

struct StaticMeshBake;		// gfx/glpipeline/static_mesh.cc (E3 phase 1)
struct RecordedFace;
struct RBStaticTriangle;

//============================================================================
// Shared model geometry v1 (see the comment above the loader in rendobj3.cc).
// An appearance MODL carries GREF + UVCL + MATL and no VRTX/FACE; GREF names a
// GEOM { POSN, FACE } asset in the appearance's own room.

struct GeometryReferenceOnDisk		// the GREF chunk, 52 bytes
{
	uint32 version;					// 1
	uint32 vertexCount;
	uint32 faceCount;
	uint32 posCrc32;				// CRC-32/ISO-HDLC of the POSN payload
	uint32 faceCrc32;				// ... and of the FACE payload
	char name[32];					// lowercase geometry asset name, NUL-terminated
};

// Validate a GREF payload. Returns NULL, or why it is malformed.
const char* ParseGeometryReference(const void* payload, int size, GeometryReferenceOnDisk& out);
// Read the GEOM asset in `geometry` and check it against `ref`: exactly one
// POSN and FACE, counts, both CRCs and every face's vertex indices. Fills the
// records as stored (positions as fixed32 x,y,z triples). Returns NULL, or why
// it does not match. Rendering and collision both read through this.
const char* ReadSharedGeometry(binistream& geometry, const GeometryReferenceOnDisk& ref,
	std::vector<int32>& positions, std::vector<_TriFaceOnDisk>& faces);
uint32 SharedGeometryCrc32(const void* data, size_t size);

// Immutable positions and material-sorted faces shared by every RenderObject3D
// whose GREF names the same geometry asset. Defined in rendobj3.cc.
struct SharedModelGeometry;

class RenderObject3D
{
public:
	RenderObject3D( Memory& memory, binistream& input, int32 userData, const GfxCallbacks& callbacks );                 // userData is passed back to LookupTexture
	// materialList is taken non-const so SetMaterialColor() can mutate it.
	RenderObject3D(Memory& memory, int vertexCount, Vertex3D* vertexList, int faceCount, TriFace* faceList, Material* materialList );
	RenderObject3D( Memory& memory, const RenderObject3D& );
	~RenderObject3D();
	// Material array is non-const so SetMaterialColor() can mutate _color in
	// place and re-bake primitives; storage ownership is unchanged.
	void ApplyMaterials( Material* materialList );
	void Render(ViewPort& vp,const Matrix34& position);

	// Runtime material color override (qbert cube consolidation, 2026-05-10).
	// Updates _materialList[idx]._color in place and re-bakes primitives so the
	// next Render() picks up the new color. No-op if idx is out of range.
	void SetMaterialColor(int idx, const Color& color);
    void SetLionPalette(unsigned dark, unsigned light);
    const std::vector<wf_render::LionRig>& GetLionRig() const { return _lionRig; }
	// Optional DFRM v1 rig (renderassets/dfrm_deform.h); NULL when absent or invalid.
	const wf_render::DfrmData* GetDfrm() const { return _dfrm.get(); }
	bool SetRuntimeGeometry(int vertices, Vertex3D* vertexList, int faces, TriFace* faceList, bool textured=true);

	// Should only be used by the animation system. Handing out writable
	// vertices also takes the object off the static-mesh path for good: a
	// deforming mesh would need a re-bake per frame, which costs more than
	// streaming it.
	Vertex3D* GetWrittableVertexList();
	int GetVertexCount() const;	// should only be used by the animation system
	// Writable faces, for a deformer that keeps face normals current (DFRM).
	// Like the vertex list, it takes the object off the static-mesh path.
	// A shared-geometry model's faces are shared by other objects: refused.
	TriFace* GetWritableFaceList();
	int GetFaceCount() const;	// measurement only (E3 phase 0 mesh-stats report)
	const TriFace* GetFaceList() const { return _faceList; }	// read-only, for tests
	// Shared model geometry: true when this object's faces come from a GREF's
	// shared record. Live records, for lifetime tests and diagnostics.
	bool UsesSharedGeometry() const { return bool(_sharedGeometry); }
	static int SharedGeometryLiveCount();
	// Read-only material access for tests (deformer_golden records lion palettes).
	int GetMaterialCount() const { return _materialCount; }
	const Material& GetMaterial(int index) const { return _materialList[index]; }
	INLINE bool GetHandle(const HandleID thisHandle, Vector3& position) const;

	inline void Validate() const;
private:
	// used by constructors
	void Construct( Memory& memory, int vertexCount,Vertex3D* vertexList, int faceCount, TriFace* faceList, Material* materialList );

#	include <gfx/glpipeline/renderer.inc>
	enum { MAX_RENDERERS = 8 };
	std::vector<Primitive> _runtimePrimitives;
    std::vector<wf_render::LionRig> _lionRig;
	std::shared_ptr<const wf_render::DfrmData> _dfrm;
	// Owner of _faceList for a GREF model (NULL otherwise). Each holder keeps
	// the record alive; the last one destroyed frees it (rendobj3.cc).
	std::shared_ptr<const SharedModelGeometry> _sharedGeometry;
	Primitive*	_primList[ORDER_TABLES];				// array of primitives, same # as face list
	Material*	_materialList;	// non-const so SetMaterialColor() can mutate; for runtime per-face color override (qbert cube consolidation, 2026-05-10).
	int			_materialCount;	// kept so SetMaterialColor() can range-check; populated by the on-disk constructor.

	int			_handleCount;		// number of handles in this object
	Handle*		_handleList;		// array of [HandleID, vertexIndex] pairs

	friend class Material;

	int			_vertexCount;
	Vertex3D*	_vertexList;
	int			_faceCount;
	TriFace*	_faceList;

	// constructor common code/helper functions
	void _InitPrimList( Memory& );

	// The per-face loop of Render (faces [firstFace, endFace)), unchanged from
	// before E3: set each material run's state, call its renderer per face.
	void StreamFaces(int firstFace, int endFace);

	// E3 phase 1: static mesh buffers (gfx/glpipeline/static_mesh.cc). The
	// object's triangles are recorded once from StreamFaces, uploaded once,
	// and drawn each frame from the bake with only the cull done per face.
	// Returns false when this object must be streamed instead.
	bool RenderStatic(const Matrix34& position);
	bool BakeStatic();
	StaticMeshBake* BakeFromRecording(RBStaticTriangle* triangles, RecordedFace* faces);
	int StaticBakeStale() const;		// 0 = valid; see static_mesh.cc
	void StaticMeshDiscard();

	// Why an object is not baked; STATIC_BAKEABLE means it may be.
	enum StaticMeshState
	{
		STATIC_BAKEABLE = 0,
		STATIC_DEFORMED,				// GetWrittableVertexList was called
		STATIC_RUNTIME_GEOMETRY,		// SetRuntimeGeometry (plants) rewrites it in place
		STATIC_SHARED_COPY,				// copy constructor: shares vertices/materials with another object
		STATIC_UNBAKEABLE,				// state varies inside a material run, or the backend refused
		STATIC_CHURN,					// invalidated repeatedly (materials re-applied per frame)
		STATIC_NO_OPAQUE				// every run is translucent: nothing to bake
	};
	StaticMeshBake* _staticBake = NULL;
	uint16 _staticVersion = 0;			// bumped whenever the primitives are rebuilt
	uint8 _staticState = STATIC_BAKEABLE;
	uint8 _staticInvalidations = 0;

	// not to be called
	RenderObject3D( const RenderObject3D& );
};

//============================================================================

struct Vertex3DOnDisk
{
	fixed32 u,v;					        // UV coordinates for this vertex in the texture page, if textured
	Color color;						// vertex color, if shaded
   fixed32 x,y,z;
//	Vector3 position;					// position, in local coordinates
};

//============================================================================

struct RotatedVector
{
	Vector3_PS _originalVector;
	Vector3_PS _resultingVector;
	int32 _ir0;
	int32 _xy;
	int32 _flags;
	int32 _z;
};


#		include <gfx/glpipeline/rendobj3.hp>
//============================================================================
#include <gfx/rendobj3.hpi>		// include all inline definitions as appropriate
//=============================================================================
#endif
