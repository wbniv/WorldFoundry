//==============================================================================
// The bake and draw live in gfx/glpipeline/static_mesh.cc as RenderObject3D
// members; this header is what the rest of the engine needs to see.
//
// Switch: on by default. `--static-mesh=0|1` on the command line (Android:
// wf_args.txt) wins over `WF_STATIC_MESH=0|1` in the environment. Off means
// every RenderObject3D streams through DrawTriangle exactly as before E3.
// Read once, at the first draw.
//
// Cull: `--static-mesh-cull=exact|fast` (or WF_STATIC_MESH_CULL) picks the
// static path's back-face test. `exact` (the default) is the streaming test,
// bit for bit. `fast` is the precomputed s^2 d + N.w form (gfx/backface_cull.hp)
// and costs one float per baked face; it is for measurement, see the E3 phase 1
// results before making it a default.
//
// Self-check: WF_STATIC_MESH_CHECK=1 keeps a CPU copy of every bake, re-records
// each baked object at every draw, and counts (1) recorded triangles that
// differ from the bake, (2) faces whose static-path cull decision differs from
// the one DrawTriangle would make, (3) faces where the fast form disagrees with
// the exact one. One `static-mesh-check:` line goes to stderr at exit.
//============================================================================

#ifndef _STATIC_MESH_HP
#define _STATIC_MESH_HP

#include <cstddef>

void StaticMeshSetSwitch(bool on);		// --static-mesh=0|1
bool StaticMeshEnabled();
void StaticMeshSetFastCull(bool fast);	// --static-mesh-cull=fast|exact

// Texture placement in VRAM may have changed (a room's asset slot was loaded or
// freed). Baked UVs come from that placement (CalcUV), so every bake made
// before the call is rebuilt on its next draw.
void StaticMeshAtlasChanged();

// Main-RAM bytes the static path holds (bake bookkeeping and scratch; not the
// transient bake buffers, which are freed right after upload).
size_t StaticMeshCpuBytes();

// Once per frame, from the compositing backend's EndFrame: samples the
// static-cpu-bytes gauge and runs the test hooks of WF_STATIC_MESH_TEST:
//   atlas:N  bump the atlas generation every N frames (every bake is rebuilt;
//            no shipped level loads or frees a room slot after level load)
//   loss:N   at frame N, simulate an Android surface loss (GL names dropped,
//            every static mesh re-baked on its next draw)
// Returns true when the caller should simulate the surface loss now.
bool StaticMeshEndFrame();

#endif
