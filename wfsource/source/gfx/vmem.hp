#ifndef _VMem_HP
#define _VMem_HP

//=============================================================================

#include <pigsys/pigsys.hp>
#include <gfx/pixelmap.hp>

//=============================================================================

class VideoMemory
{
public:
	VideoMemory(Display& display);
	~VideoMemory();

	inline void Validate() const;

	enum
	{	MAX_TRANSIENT_SLOTS = 3,
		MAX_PERMENENT_SLOTS = 1,
		MAX_SLOTS = MAX_TRANSIENT_SLOTS + MAX_PERMENENT_SLOTS,
		PERMANENT_SLOT = MAX_TRANSIENT_SLOTS	  // last slot is permanent
	};

	PixelMap& GetSlotTexturePixelMap(int slot);
	PixelMap& GetSlotPalettePixelMap(int slot);

#if defined(DESIGNER_CHEATS)
	void ClearSlot(int slot) const;		// set slot back to background color, for debugging
#endif
private:

	// Fixed origin offsets — defaults frozen so the legacy VIDEO_MEMORY_IN_ONE_PIXELMAP
	// path keeps its constexpr enum below.
	enum
	{
		VRAMPaletteBaseX		= 0,
		VRAMPaletteBaseY		= 240*2,
		VRAMPermanentBaseX		= 320,
		VRAMPermanentBaseY		= 0,
		VRAMTransientBaseY		= 0,
	};

#if defined(VIDEO_MEMORY_IN_ONE_PIXELMAP)
	enum
	{
		VRAMPaletteWidth		= 320,
		// Legacy build: derived from Display::VRAMHeight; modern build (else branch
		// below) sees these knobs as runtime statics.
		VRAMPaletteHeight		= ( 512 - VRAMPaletteBaseY ) / ( MAX_SLOTS ),
		VRAMPermanentWidth		= 128,
		VRAMPermanentHeight		= 512,
		VRAMTransientBaseX		= VRAMPermanentBaseX + VRAMPermanentWidth,
		VRAMTransientWidth		= 192,
		VRAMTransientHeight		= 512,
	};
#else
	// Modern (GL) build — slot/page sizes are runtime-overridable via CLI
	// (--vram-slot-width / --vram-slot-height etc.) so high-detail levels
	// can opt into a larger layout. Defaults preserve the historical 256²
	// values that ship snowgoons/SMB/qbert/MM untouched. See
	// docs/plans/2026-05-30-runtime-vram-cli-overrides.md.
	static int VRAMPaletteWidth;     // default 256
	static int VRAMPaletteHeight;    // default 8
	static int VRAMPermanentWidth;   // default 256
	static int VRAMPermanentHeight;  // default 256
	static int VRAMTransientWidth;   // default 256
	static int VRAMTransientHeight;  // default 256
	// VRAMTransientBaseX is just VRAMPermanentBaseX + VRAMPermanentWidth at the
	// one call site (vmem.cc); no longer stored to keep this list flat.
#endif

	void AllocateTextureSlots(Display& display);
	PixelMap* AllocateTextureSlot(Display& display,
		const int16 basex, const int16 basey,
		const uint16 width, const uint16 height
		);

	PixelMap* _textures[MAX_SLOTS];
	PixelMap* _palettes[MAX_SLOTS];
};

//============================================================================
#include "vmem.hpi"	// include all inline definitions as appropriate
//=============================================================================
#endif
//=============================================================================
