//=============================================================================
// gfx/backface_cull.hp: the software back-face cull, shared by both draw paths
// Copyright ( c ) 2026 World Foundry Group
// Part of the World Foundry 3D video game engine/production environment
// for more information about World Foundry, see www.worldfoundry.org
//==============================================================================
// One definition of the normal-based back-face test, used by the streaming path
// (ModernRendererBackend::DrawTriangle) and by the static-mesh path
// (RenderObject3D::RenderStatic, E3 phase 1). Exact pixel parity between the
// two paths needs bit-identical cull decisions, so both evaluate the SAME
// expressions in the SAME order from the same floats; keeping the arithmetic in
// one inline function is what makes that hold by construction rather than by
// two hand-maintained copies agreeing.
//
// The model-view conversion lives here too: the static path builds its float
// matrix from the Matrix34 that RenderObject3D::Render hands to SetModelView,
// and must get the bits the backend's `_mv` holds.
//
// See docs/plans/2026-06-13-planetarium-dome-view-engine-wide-backface-culling.md
// for why the test uses the stored face normal and not the winding, and the
// E3 plan (finding-your-way docs/plans/2026-10-08-e3-static-vertex-buffers.md)
// for the precomputed form below.
//============================================================================

#ifndef _BACKFACE_CULL_HP
#define _BACKFACE_CULL_HP

#include <math/matrix34.hp>
#include <cmath>
#include <cstdlib>

// WF_CULL=0 opts out of the software cull (default ON since 2026-09-21; see
// the comment in backend_modern.cc's DrawTriangle). Read once. An inline
// function's static local is one object across translation units, so both
// draw paths see the same value.
inline bool
WfBackfaceCullEnabled()
{
	static const bool enabled = []() {
		const char* e = getenv("WF_CULL");
		return !e || atoi(e) != 0;
	}();
	return enabled;
}

// WF's 3x4 row-vector matrix as a GL 4x4 column-major float matrix.
inline void
WfMatrix34ToGL(const Matrix34& matrix, float out[16])
{
	out[0]  = matrix[0][0].AsFloat();
	out[1]  = matrix[0][1].AsFloat();
	out[2]  = matrix[0][2].AsFloat();
	out[3]  = 0.0f;

	out[4]  = matrix[1][0].AsFloat();
	out[5]  = matrix[1][1].AsFloat();
	out[6]  = matrix[1][2].AsFloat();
	out[7]  = 0.0f;

	out[8]  = matrix[2][0].AsFloat();
	out[9]  = matrix[2][1].AsFloat();
	out[10] = matrix[2][2].AsFloat();
	out[11] = 0.0f;

	out[12] = matrix[3][0].AsFloat();
	out[13] = matrix[3][1].AsFloat();
	out[14] = matrix[3][2].AsFloat();
	out[15] = 1.0f;
}

// The exact test. Eye space: the camera sits at the origin looking down -Z.
// Transform the object-space normal by mv's upper 3x3 and the face centre by
// the full mv; the face points away from the camera when dot(Ne, Pe) > 0.
inline bool
WfFaceIsBackfacing(const float mv[16], float nx, float ny, float nz,
                   float x0, float y0, float z0,
                   float x1, float y1, float z1,
                   float x2, float y2, float z2)
{
	const float nex = mv[0]*nx + mv[4]*ny + mv[8]*nz;
	const float ney = mv[1]*nx + mv[5]*ny + mv[9]*nz;
	const float nez = mv[2]*nx + mv[6]*ny + mv[10]*nz;
	const float cx = (x0 + x1 + x2) * (1.0f / 3.0f);
	const float cy = (y0 + y1 + y2) * (1.0f / 3.0f);
	const float cz = (z0 + z1 + z2) * (1.0f / 3.0f);
	const float pex = mv[0]*cx + mv[4]*cy + mv[8]*cz  + mv[12];
	const float pey = mv[1]*cx + mv[5]*cy + mv[9]*cz  + mv[13];
	const float pez = mv[2]*cx + mv[6]*cy + mv[10]*cz + mv[14];
	return nex*pex + ney*pey + nez*pez > 0.0f;
}

// The precomputed form (E3 plan, "One cull formula, evaluated cheaply").
// Ne.Pe = N.(R^T R C + R^T t); when R is a rotation with uniform scale s,
// R^T R = s^2 I, so the test is s^2 d + N.w > 0 with d = N.C baked per face
// and w = R^T t once per object. It is algebraically equal to the exact test
// but rounds differently, so a face that is (nearly) edge-on can get the other
// answer: it is only used where measurement shows zero differing decisions.
struct WfCullFrame
{
	bool similarity;		// R is a rotation times a uniform scale (to 1e-5)
	float s2;
	float w[3];
};

inline void
WfCullFramePrepare(const float mv[16], WfCullFrame& frame)
{
	const float* c0 = &mv[0];
	const float* c1 = &mv[4];
	const float* c2 = &mv[8];
	const float n0 = c0[0]*c0[0] + c0[1]*c0[1] + c0[2]*c0[2];
	const float n1 = c1[0]*c1[0] + c1[1]*c1[1] + c1[2]*c1[2];
	const float n2 = c2[0]*c2[0] + c2[1]*c2[1] + c2[2]*c2[2];
	const float o01 = c0[0]*c1[0] + c0[1]*c1[1] + c0[2]*c1[2];
	const float o02 = c0[0]*c2[0] + c0[1]*c2[1] + c0[2]*c2[2];
	const float o12 = c1[0]*c2[0] + c1[1]*c2[1] + c1[2]*c2[2];
	const float tolerance = 1e-5f * n0;
	frame.similarity = n0 > 0.0f
		&& std::fabs(n0 - n1) <= tolerance && std::fabs(n0 - n2) <= tolerance
		&& std::fabs(o01) <= tolerance && std::fabs(o02) <= tolerance && std::fabs(o12) <= tolerance;
	frame.s2 = (n0 + n1 + n2) * (1.0f / 3.0f);
	frame.w[0] = c0[0]*mv[12] + c0[1]*mv[13] + c0[2]*mv[14];
	frame.w[1] = c1[0]*mv[12] + c1[1]*mv[13] + c1[2]*mv[14];
	frame.w[2] = c2[0]*mv[12] + c2[1]*mv[13] + c2[2]*mv[14];
}

inline bool
WfFaceIsBackfacingFast(const WfCullFrame& frame, float nx, float ny, float nz, float d)
{
	return frame.s2*d + (nx*frame.w[0] + ny*frame.w[1] + nz*frame.w[2]) > 0.0f;
}

// d = N.C for the precomputed form, with C computed exactly as the exact test
// computes it.
inline float
WfFacePlaneD(float nx, float ny, float nz,
             float x0, float y0, float z0,
             float x1, float y1, float z1,
             float x2, float y2, float z2)
{
	const float cx = (x0 + x1 + x2) * (1.0f / 3.0f);
	const float cy = (y0 + y1 + y2) * (1.0f / 3.0f);
	const float cz = (z0 + z1 + z2) * (1.0f / 3.0f);
	return nx*cx + ny*cy + nz*cz;
}

#endif
