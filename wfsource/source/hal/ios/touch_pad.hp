// Copyright ( c ) 2026 World Foundry Group
// Part of the World Foundry 3D video game engine/production environment
// for more information about World Foundry, see www.worldfoundry.org
//=============================================================================
// The controls themselves (layout, hit test, finger ownership, the card-open
// narrowing to A and C) are hal/touch_controls.h, the same code Android runs.
// This file adapts UIKit's touch model to it, with no UIKit and no engine
// headers, so it compiles and is unit-tested on Linux (tests/touch_pad_test.cc,
// driven by tests/test_ios_touch_pad.py):
//   - UIKit names a finger by its UITouch pointer; wftouch::Point::id is an
//     int. Pad gives each finger a fresh int when it lands (never reused).
//   - UIKit sends began/moved/ended/cancelled per touch; these become
//     wftouch::State::update calls with Android's Down/Move/Up. A lifting
//     finger stays in the point list for its Up, as in ACTION_POINTER_UP;
//     when the last finger lifts the state clears, as on ACTION_UP.
//   - Sizes are points with density 1 (an iPhone point is about one dp),
//     inside the safe area on every side (wftouch::layout with Insets).
//   - SetReading() narrows to A and C and drops a finger already on the
//     joystick, B or D at once. Android drops it on the next motion event,
//     which real glass sends almost at once; a still UIKit finger sends none.
// Plan: finding-your-way docs/plans/2026-11-08-ios-touch-parity.md.
//=============================================================================

#ifndef _WF_HAL_IOS_TOUCH_PAD_HP
#define _WF_HAL_IOS_TOUCH_PAD_HP

#include <cstddef>
#include <cstdint>

#include <hal/touch_controls.h>

namespace wf_touch
{

// Button bits. Must equal EJ_BUTTONF_* in hal/sjoystic.h: input.mm
// static_asserts this on iOS, and tests/test_ios_touch_pad.py checks the
// wftouch constants against the header on Linux.
constexpr uint32_t kBtnA     = wftouch::A;
constexpr uint32_t kBtnB     = wftouch::B;
constexpr uint32_t kBtnC     = wftouch::C;
constexpr uint32_t kBtnD     = wftouch::D;
constexpr uint32_t kBtnUp    = wftouch::Up;
constexpr uint32_t kBtnDown  = wftouch::Down;
constexpr uint32_t kBtnRight = wftouch::Right;
constexpr uint32_t kBtnLeft  = wftouch::Left;
constexpr uint32_t kStickBits = kBtnUp | kBtnDown | kBtnLeft | kBtnRight;

// Main-thread only; not thread-safe.
class Pad
{
public:
    static constexpr int kMaxTouches = 16;   // an iPad reports up to 11

    // View size in points and its safe-area insets. Held fingers are
    // re-hit against the new layout.
    void SetView(float viewW, float viewH, const wftouch::Insets& safe);
    // True while a story card is open: only A and C are shown and hit.
    void SetReading(bool reading);
    bool Reading() const { return _reading; }

    void Began(uintptr_t key, float x, float y);
    void Moved(uintptr_t key, float x, float y);   // unknown key: Began
    void Ended(uintptr_t key);                     // also cancelled touches
    void ReleaseAll();

    // The layout in force (narrowed while reading): what is drawn and hit.
    const wftouch::Layout& CurrentLayout() const { return _layout; }
    uint32_t       Buttons() const { return _mask; }
    wftouch::Stick StickPosition() const { return _state.position; }
    int            Count() const { return _count; }

private:
    struct Finger { uintptr_t key; int id; float x, y; };
    int  Find(uintptr_t key) const;
    void Update(wftouch::Action action, int changed);

    Finger          _fingers[kMaxTouches] = {};
    int             _count  = 0;
    int             _nextId = 1;
    wftouch::Layout _full;
    wftouch::Layout _layout;
    bool            _reading = false;
    wftouch::State  _state;
    uint32_t        _mask = 0;
};

// Scripted synthetic touches for Simulator CI (see input.mm). Grammar,
// whitespace-free:
//   entry  := button '@' start '+' duration      (seconds, decimal)
//   script := entry (',' entry)*
//   button := up | down | left | right | a | b | c | d
// e.g. "right@2+3,a@6+0.2,up@7+1". Overlapping entries are chords.
struct ScriptEntry
{
    uint32_t button = 0;
    float    start  = 0;
    float    duration = 0;
};

constexpr int kMaxScriptEntries = 64;

// Returns the number of entries parsed into out[0..max), or -1 on any
// syntax error (nothing is played then).
int ParseScript(const char* text, ScriptEntry* out, int max);

// The point to press for a script button: A to D at their square's centre
// (even while hidden, so a script can show a hidden button is not hit); a
// direction at the joystick centre plus 0.9 of its radius that way.
bool ButtonCenter(const wftouch::Layout& layout, uint32_t button, float* x, float* y);

}  // namespace wf_touch

#endif
