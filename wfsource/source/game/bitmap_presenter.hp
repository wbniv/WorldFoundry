#ifndef _BITMAP_PRESENTER_HP
#define _BITMAP_PRESENTER_HP
#include "bitmap_text.hp"
#include <gfx/renderer_backend.hp>
class Mailboxes;
namespace bitmaptext
{
class Presenter
{
public:
    bool Load(const void* data,size_t bytes,const char*& error);
    ~Presenter();
    void BeginLabels();
    bool CaptureLabel(int actor, float x, float y, float z, int width, int height);
    void Draw(Mailboxes& mailboxes,int width,int height);
    void Validate() const;
private:
    Catalog _catalog;
    Layout _body, _heading, _controls;
    Quad _quads[Layout::MAX_QUADS];
    enum { MAX_LABELS=128, MAX_LABEL_GLYPHS=2048 };
    struct Sign { int actor, first, count; float x,y,depth; bool visible; };
    Sign _signs[MAX_LABELS];
    Quad _signQuads[MAX_LABEL_GLYPHS];
    int _signCount=0, _signHeight=-1;
    int _beat=0, _width=0, _height=0, _size=-1, _page=-1, _capacity=1;
    int _bodyVariant=0, _headingVariant=0, _controlVariant=0;
    int _bodyX=0, _bodyY=0, _headingY=0, _controlY=0, _quadCount=0;
    Text _text={};
    RBTextureHandle _texture=NULL;
    unsigned _generation=0;
    void BuildSigns(int height);
    void Fatal(const char* error) const;
};
}
#endif
