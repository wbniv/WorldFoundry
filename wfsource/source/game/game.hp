#ifndef _GAME_HP
#define _GAME_HP

//-----------------------------------------------------------------------------

#include <hal/sjoystic.h>
#include <hal/_mempool.h>
#include <hal/diskfile.hp>
#include <math/scalar.hp>
#include <input/inputdig.hp>
#include <iff/disktoc.hp>

#include <gfx/display.hp>
#include <gfx/vmem.hp>
#include <gfx/viewport.hp>
#include "actor.hp"

class Level;
class GameMailboxes;

//=============================================================================

const int NumJoysticks = 2;

//=============================================================================

class WFGame
{
public:
	WFGame( const int nStartingLevel = 0 );
	~WFGame();

	// One-tick result. Rendered = normal frame ran; Suspended = platform
	// backgrounded us (Android onPause), no render/PageFlip happened;
	// Done = level reported done() (caller should stop the loop).
	enum class FrameResult { Rendered, Suspended, Done };

	// Per-level lifecycle. RunLevel = LoadLevel + while-loop + UnloadLevel
	// for standalone wf_game. Hosts (editor, replay driver, test harness)
	// call LoadLevel + StepFrame... + UnloadLevel directly.
	void LoadLevel(_DiskFile* levelFile);
	void UnloadLevel();
	void RunLevel(_DiskFile* levelFile);		// executes a single level, returns when done
	void RunGameScript();				// runs the whole game, returns when game (really) over (quit to OS)

	// One tick of the inner game loop. do_swap=true (default) drives
	// _display->PageFlip(); do_swap=false uses _display->MeasureDelta()
	// so a host that swaps its own buffers (editor compositing widgets
	// on top of the engine draw) still gets an honest deltaTime.
	// out_dt, if non-null, receives the deltaTime for this frame.
	FrameResult StepFrame(bool do_swap = true, Scalar* out_dt = nullptr);

	// Smoke entry-point for the frame-step API. Demonstrates the
	// "external host drives the engine" path by calling LoadLevel +
	// N StepFrame + UnloadLevel directly (bypassing RunLevel). The
	// existing gLevelOverridePath ("-L") supplies the level file.
	// Used by wf_game's --frame-step-smoke=N CLI flag and as the
	// reference for editor / replay / test-harness integration. Pass
	// cycles>1 to run multiple LoadLevel→StepFrame×N→UnloadLevel cycles
	// (multi-cycle stability regression coverage).
	void SmokeRunFrameStep(int frames, int cycles = 1);

#if defined(WF_DEBUG_BRIDGE) || defined(WF_ENABLE_EDITOR)
	// Smoke entry-point for the wfmut:: engine mutation API. Loads the level
	// supplied via -L<path>, runs wfmut::RunSmokeTests(level), and unloads.
	// Returns the number of failed assertions (0 = all green) — used by
	// wf_game's --wfmut-smoke CLI as the process exit code. Available under
	// both consumer flags since wfmut sits at the union.
	// Plan: docs/plans/2026-05-19-engine-mutation-api.md.
	int RunWfmutSmoke();

	// X5 death-test: drives wfmut from a non-game thread, expecting the
	// cross-thread guard to abort. wf_game's --wfmut-thread-test CLI.
	int RunWfmutThreadTest();
#endif

	Level* CurrentLevel() const { return _curLevel; }

	// Level-loop predicates for host-driven loops. LevelDone reads the
	// loaded level's done() flag; ContinueRequested is the inverse of
	// the abort flag (PIGSUserAborted has set _bContinue=false inside
	// StepFrame). Defined inline in game.cc to avoid pulling level.hp.
	bool LevelDone() const;
	bool ContinueRequested() const { return _bContinue; }

	SMemPool* MessagePortMemPool();

	// mailbox methods
	void WriteSystemMailbox( int boxnum, Scalar value );
	Scalar ReadSystemMailbox( int boxnum ) const;

#if SW_DBSTREAM			                // used to load objects.id for actor printing
	inline int32 GetLevelNum() const;
#endif

	//const Actor&		GetActor() const    	{ return _ActorLevel; }

protected:
	void				DistributorLogo();
	void	   		PublisherLogo();
	void	  			DeveloperLogo();

private:
	Display* 			_display;
	VideoMemory*      _videoMemory;
	ViewPort* 			_viewPort;

	// Memory pool for allocating MsgPort messages
	enum { MSGPORTPOOLSIZE = 500 };	// Max number of MsgPort messages
	SMemPool*			_msgPortMemPool;

	// persistent system mailboxes
	int32				_desiredLevelNum;  // which level will run next
	int32				_overrideLevelNum;  // override from the command line
	_DiskFile* 			_gameFile;				// cd.iff
	DiskTOC				_gameTOC;

	// Per-level state. Owned by LoadLevel / UnloadLevel; null when no level
	// is loaded. _gameMailboxes outlives _curLevel because the level's
	// _scratchMailboxes holds a parent pointer to it.
	Level*			_curLevel;
	GameMailboxes*	_gameMailboxes;
	bool			_bContinue;		// false short-circuits the level loop (PIGSUserAborted)
	Scalar			_deltaTime;		// last frame's delta; fed back into next update()

public:
//     class LevelActor : public Actor
//     {
//     public:
//         LevelActor() : Actor()
//         {
//             _idxActor = 1;
//         }
//         ~LevelActor()           {}
//         virtual EActorKind kind() const { return EActorKind( -1 ); }
//     };
	//static const LevelActor	_ActorLevel;
};

//=============================================================================
// (extern WFGame* theGame removed 2026-05-18 — Phase 0b WFGame de-globaling.
// Level holds a WFGame& reference; debug-only Actor::Print's level-number
// lookup uses Actor::SetPrintLevelNum, set by Level::Level.)
//=============================================================================
#include "game.hpi"	// include all inline definitions as appropriate
//=============================================================================
#endif // !_GAME_HP
//=============================================================================
