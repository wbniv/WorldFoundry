#ifndef _FPS_OVERLAY_HP
#define _FPS_OVERLAY_HP

#include <math/scalar.hp>
#include <hal/phonepad/phonepad_overlay.h>

namespace fpscounter
{
extern bool enabled;

// Cached text geometry in surface pixels, independent of the game HUD.
class Overlay
{
public:
	int Build(Scalar fps, int width, int height);
	const PhonepadRect* Rects() const { Validate(); return _rects; }
	void Validate() const;
	const char* Text() const { Validate(); return _text; }
private:
	char _text[32] = "";
	int _width = 0, _height = 0;
	enum { MAX_QUADS = 128 };
	PhonepadRect _rects[MAX_QUADS + 1];
	float _vertices[MAX_QUADS * 16];
	int _count = 0;
};
}

#endif // _FPS_OVERLAY_HP
