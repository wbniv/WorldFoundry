//
// A settings holder (oas/settings.inc, oas/plantedtanksettings.oas): an actor
// that never renders or updates and only carries the tank's options in its OAD
// struct. Registered in objects.mac so the type id exists; no level places one
// until the planted tank migrates to it (runtime object editing, Phase 3).
//============================================================================

#ifndef _PlantedTankSettings_HP
#define _PlantedTankSettings_HP

#include "actor.hp"

class PlantedTankSettings: public Actor
{
public:
	PlantedTankSettings(const SObjectStartupData* startupData);
	virtual ~PlantedTankSettings()	{ }

	virtual EActorKind kind() const;

	virtual void update();

	virtual bool CanRender() const;
	virtual bool CanUpdate() const;
};

Actor*
OadPlantedTankSettings(const SObjectStartupData* startupData);

#endif // !_PlantedTankSettings_HP
